generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?   @map("full_name")
  password    String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isAdmin     Boolean   @default(false) @map("is_admin")
  isDriver    Boolean   @default(false) @map("is_driver")
  phoneNumber String
  expenses    Expense[]

  @@map("users")
}

model Vehicle {
  id                     Int       @id @default(autoincrement())
  number                 String?
  name                   String?
  category               String?
  oilLastChangedHour     Int?      @map("oil_last_changed_hour")
  oilChangeIntervalHours Int?      @map("oil_change_interval_hours")
  totalHoursRan          Int?      @map("total_hours_ran")
  description            String?
  createdAt              DateTime  @default(now()) @map("created_at")
  expenses               Expense[]

  @@map("vehicles")
}

model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  vehicleId   Int      @map("vehicle_id")
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  description String
  expenseTime DateTime @default(now()) @map("expense_time")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("expenses")
}
